# Any OpenAI-compatible Chat Completions endpoint with tool calling works.

# OpenAI (default)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4.1-mini

# Maritaca AI (Brazilian Portuguese models)
# OPENAI_API_KEY=<maritaca key>
# OPENAI_BASE_URL=https://chat.maritaca.ai/api
# LLM_MODEL=sabia-4

# Ollama (local, free; pick a model with tool support)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct

# Optional: freeze the clock (ISO 8601, store timezone is America/Campo_Grande)
# EMPORIO_NOW=2026-11-03T10:30:00
